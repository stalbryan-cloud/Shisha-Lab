# ── Public (safe for the browser) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Display name; can also be changed at runtime in Admin → Site (site_settings.site_name)
NEXT_PUBLIC_SITE_NAME="SHISHA LAB"

# ── Server only — NEVER prefix with NEXT_PUBLIC_ and never import into client components ──
# Used solely for account deletion and the trending cron. Everything else runs with the user's own JWT + RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Secret that protects /api/cron/* (set the same value in Vercel Cron headers)
CRON_SECRET=generate-a-long-random-string
# Only for `npm run db:seed` / `npm run test:db` against a direct connection
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
